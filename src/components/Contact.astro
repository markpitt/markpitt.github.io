<section id="contact" class="py-24 px-6 border-t border-ink/10">
  <div class="max-w-5xl mx-auto">
    <h2 class="font-mono text-accent text-xs tracking-widest uppercase mb-10">Contact</h2>
    <div class="max-w-xl">
      <p class="text-ink leading-relaxed mb-8">
        You can reach me by email or on LinkedIn.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="mailto:markjpitt@gmail.com"
          class="inline-flex items-center gap-2 font-mono text-sm text-accent hover:underline"
        >
          markjpitt@gmail.com <span aria-hidden="true">↗</span>
        </a>
        <a
          href="https://linkedin.com/in/markpitt"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 font-mono text-sm text-muted hover:text-accent transition-colors duration-150"
        >
          LinkedIn <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
        </a>
      </div>
    </div>
  </div>
</section>
