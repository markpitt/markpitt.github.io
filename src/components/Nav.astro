---
// The site header, from the shared markpitt.dev chrome kit (Header.astro, beside chrome.css).
// The main site and every project site draw the same header from one kit, so the nav cannot
// drift between them. `home=""` keeps Skills and Projects as site-relative links, `local` makes
// the section links in-page anchors and the lockup plain text, and `fixed` keeps it over the hero,
// which pads for it.
//
// The kit keeps the behaviour this component used to own, with its reasons in its comments:
// the <details> menu with [open] as the only state, the 724px collapse width, the menu-closing
// script (close on a link, Escape, focus leaving and a click outside), and the single cycling
// theme button that Base.astro's script drives through data-theme-toggle.
import Header from "@chrome/Header.astro";
import type { SitePage } from "@chrome/nav";

interface Props {
  /** The nav item this page belongs to. None on the home page. */
  page?: SitePage;
}

const { page } = Astro.props;
// On the home page the section links are in-page anchors; on any other page they lead back to it.
const local = page === undefined;
---

<Header home="" local={local} current={page} position="fixed" />
